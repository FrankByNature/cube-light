#include <Adafruit_NeoPixel.h>
#include <Wire.h>

//Output pins
int P1 = 8; int P2 = 7; int P3 = 6; int P4 = 5; int P5 = 4;
int NUM_LED = 25;
int I2C_adrs = 32;

// 16-bit LED values: upper 8 bits = integer (0-64), lower 8 bits = fraction
uint16_t LEDs[2][5][25][3] = {0};
volatile int writeBuffer = 0;
volatile int readBuffer = 1;
volatile bool newFrame = false;

// Dither accumulators - one per LED per channel
uint8_t accum[5][25][3] = {0};

