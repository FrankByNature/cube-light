Adafruit_NeoPixel strip1(NUM_LED, P1, NEO_GRB + NEO_KHZ800);
Adafruit_NeoPixel strip2(NUM_LED, P2, NEO_GRB + NEO_KHZ800);
Adafruit_NeoPixel strip3(NUM_LED, P3, NEO_GRB + NEO_KHZ800);
Adafruit_NeoPixel strip4(NUM_LED, P4, NEO_GRB + NEO_KHZ800);
Adafruit_NeoPixel strip5(NUM_LED, P5, NEO_GRB + NEO_KHZ800);

// Helper to get a dithered 8-bit output value for one channel of one LED
uint8_t dither(int strip, int led, int ch) {
  uint16_t val     = LEDs[readBuffer][strip][led][ch];
  uint8_t integer  = val >> 8;
  uint8_t fraction = val & 0xFF;
  accum[strip][led][ch] += fraction;
  if (accum[strip][led][ch] < fraction) integer++;
  return integer;
}

void setup() {
  // Address Selection: 33(1,0,0), 34(0,1,0), 35(1,1,0), 36(0,0,1), 37(1,0,1)
  pinMode(27, INPUT); pinMode(28, INPUT); pinMode(29, INPUT);
  v1 = digitalRead(27); v2 = digitalRead(28); v3 = digitalRead(29);
  int I2C_adrs = 32 + v1 + 2*v2 + 4*v3;
  Wire.setSDA(0); Wire.setSCL(1);
  Wire.begin(I2C_adrs);
  Wire.onReceive(rcv);
}

void loop() {
  tight_loop_contents();
}

void setup1() {
  strip1.begin(); strip2.begin(); strip3.begin(); strip4.begin(); strip5.begin();
  strip1.show(); strip2.show(); strip3.show(); strip4.show(); strip5.show();
}

void loop1() {
  if (newFrame) {
    newFrame = false;
    writeBuffer = 1 - writeBuffer;
    readBuffer = 1 - writeBuffer;
  }
    
  for (int x = 0; x < 5; x++) {
    strip1.setPixelColor(x, dither(0,x,0), dither(0,x,1), dither(0,x,2));
    strip2.setPixelColor(x, dither(1,x,0), dither(1,x,1), dither(1,x,2));
    strip3.setPixelColor(x, dither(2,x,0), dither(2,x,1), dither(2,x,2));
    strip4.setPixelColor(x, dither(3,x,0), dither(3,x,1), dither(3,x,2));
    strip5.setPixelColor(x, dither(4,x,0), dither(4,x,1), dither(4,x,2));
  }
  strip1.show(); strip2.show(); strip3.show(); strip4.show(); strip5.show();
}

void rcv(int byteCount) {  
  int counter = 0;
  int data[16] = {0};
  while(Wire.available() && counter < 16) {
      data[counter++] = Wire.read();
  }
  
  int target_strip = data[0];

  for (int x = 0; x < 5; x++) {
    for (int y = 0; y < 3; y++) {
      uint8_t incoming = data[1 + x*3 + y];
      LEDs[writeBuffer][target_strip][x][y] = gamma16[incoming];
    }
  }

  if (target_strip == 4) {
    newFrame = true;
  }
}
