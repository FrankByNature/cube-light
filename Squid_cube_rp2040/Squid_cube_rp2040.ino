#include <Adafruit_NeoPixel.h>
#include <Wire.h>

//Output pins
int P1 = 4; int P2 = 5; int P3 = 6; int P4 = 7; int P5 = 8;
int NUM_LED = 5;
int v1; int v2; int v3;
int LEDs[2][5][5][3] = {0};
volatile int writeBuffer = 0;
volatile int readBuffer = 1;
volatile bool newFrame = false;

// Dither accumulators - one per LED per channel
uint8_t accum[5][5][3] = {0};

